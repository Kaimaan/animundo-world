{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kaimaan/animundo-world/schemas/tree.schema.json",
  "title": "Tree spec",
  "description": "models/trees/<id>.json: a tree built from blocks by tools/blender/build_tree.py (tools/tree_shape.py). A region uses it with trees.mix[].shape = its id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "latin", "taxon", "sources", "kind", "trunk", "crown", "colors"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "status": {"enum": ["draft", "reviewed", "released"]},
    "name": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "latin": {"type": "string", "minLength": 3},
    "taxon": {"type": "object", "required": ["gbif_key", "rank", "name"], "properties": {"gbif_key": {"type": "integer"}, "rank": {"type": "string"}, "name": {"type": "string"}}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "kind": {"const": "tree"},
    "trunk": {
      "type": "object", "additionalProperties": false, "required": ["height"],
      "properties": {
        "height": {"description": "Lowest and highest trunk, in blocks (metres).", "type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 16}, "minItems": 2, "maxItems": 2},
        "girth": {"description": "Trunk width in blocks.", "enum": [1, 2, 3]},
        "lean": {"description": "Blocks the top of the trunk leans over (palms).", "type": "integer", "minimum": 0, "maximum": 4},
        "roots": {"description": "Stilt roots arching from the trunk to the ground (mangroves).", "type": "object", "additionalProperties": false,
          "properties": {"count": {"type": "integer", "minimum": 3, "maximum": 10}, "spread": {"type": "integer", "minimum": 1, "maximum": 4}, "height": {"type": "integer", "minimum": 1, "maximum": 5}}}
      }
    },
    "crown": {
      "type": "object", "additionalProperties": false, "required": ["shape"],
      "properties": {
        "shape": {"enum": ["round", "cone", "column", "umbrella", "palm"]},
        "radius": {"type": "number", "minimum": 0.5, "maximum": 8},
        "squash": {"type": "number", "minimum": 0.3, "maximum": 4},
        "height": {"type": "integer", "minimum": 2, "maximum": 16},
        "thickness": {"type": "integer", "minimum": 1, "maximum": 4},
        "branches": {"type": "integer", "minimum": 1, "maximum": 3},
        "fronds": {"type": "integer", "minimum": 3, "maximum": 16},
        "length": {"type": "integer", "minimum": 2, "maximum": 8},
        "droop": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "colors": {
      "type": "object", "additionalProperties": false, "required": ["trunk", "leaves"],
      "properties": {
        "trunk": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "leaves": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "autumn": {"description": "Deciduous trees: the autumn colour; the leaves fall after it.", "type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
      }
    },
    "on": {"description": "The ground it grows on (default grass); water is shallow water, at most 2 blocks deep, over sand or mud.", "type": "array", "items": {"enum": ["grass", "rock", "sand", "water"]}, "minItems": 1, "uniqueItems": true}
  }
}
